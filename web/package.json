{
  "name": "proreta-web",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "PRORETA_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o src/api/generated/schema.ts && prettier --write src/api/generated",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
