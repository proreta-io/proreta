{{define "body"}}<h1 style="margin:0 0 16px;font-size:20px;line-height:1.3">Confirm your email address</h1>
<p style="margin:0 0 16px">Someone registered <strong>{{.Params.email}}</strong> on Proreta. To confirm that the address is yours, open this link:</p>
<p style="margin:0 0 16px"><a href="{{.Link}}" style="color:#1a1a1a;font-weight:600">Confirm my email address</a></p>
<p style="margin:0 0 16px;font-size:13px;color:#6b6b63;word-break:break-all">If the link does not open, copy this address into your browser:<br>{{.Link}}</p>
<p style="margin:0 0 16px">The link works once and expires in {{.Params.expires}}.</p>
<p style="margin:0">If you did not register, ignore this message: nothing happens unless the link is opened.</p>{{end}}
{{define "footer"}}Sent by {{.PublicHost}}.{{end}}
