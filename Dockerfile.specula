# syntax=docker/dockerfile:1.7
# The Specula executor alone: it runs inside a customer's network, so the image holds one static binary
# and nothing else (no api, worker, migrate or proretactl). Same pinned bases and build flags as Dockerfile.
# Multi-arch: the Go toolchain runs on the build platform and cross-compiles (no emulation).

FROM --platform=$BUILDPLATFORM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o /out/specula ./cmd/specula
RUN mkdir /out/state

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/specula /app/specula
# A named Docker volume mounted here inherits the owner, so the executor can write its buffer as the nonroot user.
COPY --from=build --chown=65532:65532 /out/state /var/lib/specula
USER 65532:65532
ENTRYPOINT ["/app/specula"]
